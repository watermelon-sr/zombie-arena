--// 4. Toggle Menu with Tap Protection
local dragThreshold = 5
local startClickPos

ToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        startClickPos = input.Position
    end
end)

ToggleBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local endPos = input.Position
        -- Only open menu if you tapped, not if you dragged the button across the screen
        if (endPos - startClickPos).Magnitude < dragThreshold then
            MenuBox.Visible = not MenuBox.Visible
        end
    end
end)

