--// 6. The 999+ Wave Engine (Gun-Only + Anti-Self Kill)
RunService.Heartbeat:Connect(function()
    if not Config.AutoKill then return end
    
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local hrp = Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- STRICT CHECK: Are you holding a tool/gun? If not, stop here.
    local equippedTool = Character:FindFirstChildOfClass("Tool")
    if not equippedTool then return end 

    local zombiesFolder = workspace:FindFirstChild("Zombies") or workspace:FindFirstChild("Enemies") or workspace
    local processedThisFrame = 0 
    
    for _, zombie in ipairs(zombiesFolder:GetChildren()) do
        if processedThisFrame >= 40 then break end -- Prevents lag on wave 999+
        
        -- STRICT CHECK: Make absolutely sure the target is NOT you
        if zombie ~= Character and zombie.Name ~= LocalPlayer.Name then
            local zHum = zombie:FindFirstChild("Humanoid")
            local zHrp = zombie:FindFirstChild("HumanoidRootPart")
            
            if zHum and zHrp and zHum.Health > 0 then
                -- Target range (Adjust to 100 so it shoots from further away)
                if (zHrp.Position - hrp.Position).Magnitude <= 100 then
                    pcall(function()
                        -- Try firing the tool's remote event first (very common in gun games)
                        local toolRemote = equippedTool:FindFirstChildWhichIsA("RemoteEvent")
                        if toolRemote then
                            toolRemote:FireServer(zHrp.Position, zombie)
                        else
                            -- Fallback to global game remotes
                            local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                            if remote and remote:FindFirstChild("Attack") then
                                remote.Attack:FireServer(zombie)
                            else
                                -- Absolute brute-force fallback
                                zHum.Health = 0 
                            end
                        end
                    end)
                    processedThisFrame = processedThisFrame + 1
                end
            end
        end
    end
end)

