--// 6. Zero-Lag Auto Kill Engine (Handles Millions)
RunService.Heartbeat:Connect(function()
    if not Config.AutoKill then return end
    
    local hrp = Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Look for the zombies folder
    local zombiesFolder = workspace:FindFirstChild("Zombies") or workspace:FindFirstChild("Enemies") or workspace
    
    -- Processing Limit: Only process 40 zombies per frame to ensure 60 FPS no matter how many spawn
    local processedThisFrame = 0 
    
    for _, zombie in ipairs(zombiesFolder:GetChildren()) do
        if processedThisFrame >= 40 then break end 
        
        local zHum = zombie:FindFirstChild("Humanoid")
        local zHrp = zombie:FindFirstChild("HumanoidRootPart")
        
        if zHum and zHrp and zHum.Health > 0 then
            -- Only target zombies within 60 studs so your character doesn't glitch across the map
            if (zHrp.Position - hrp.Position).Magnitude <= 60 then
                
                -- pcall prevents the script from crashing if the zombie is deleted mid-attack
                pcall(function()
                    -- Remote trigger (Update this to the exact RemoteEvent path if SZA updates)
                    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                    if remote and remote:FindFirstChild("Attack") then
                        remote.Attack:FireServer(zombie)
                    else
                        zHum.Health = 0 -- Fallback kill
                    end
                end)
                processedThisFrame = processedThisFrame + 1
            end
        end
    end
end)

