-- Draggable logic
local function Drag(obj)
    local drag, start, pos
    obj.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; start = i.Position; pos = obj.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType.Touch) then
            local d = i.Position - start
            obj.Position = UDim2.new(pos.X.Scale, pos.X.Offset + d.X, pos.Y.Scale, pos.Y.Offset + d.Y)
        end
    end)
    obj.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = false
            if (i.Position - (start or i.Position)).Magnitude < 5 then
                if obj == MainBtn then Menu.Visible = not Menu.Visible end
            end
        end
    end)
end
Drag(MainBtn)

--// THE UNSTOPPABLE AUTO-KILL
-- Optimized for Hardcore Mode
RunService.Stepped:Connect(function()
    if Config.Kill then
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        
        -- Script only runs if you are holding a gun (like the Pistol in your screenshot)
        if tool then
            -- Scan Workspace for anything with a Humanoid
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Humanoid") and v.Parent ~= char and v.Health > 0 then
                    local root = v.Parent:FindFirstChild("HumanoidRootPart")
                    if root and (root.Position - char.HumanoidRootPart.Position).Magnitude < 100 then
                        -- Fire the gun's attack remote directly
                        local remote = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("Shoot") or game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                        pcall(function()
                            if remote:IsA("RemoteEvent") then
                                remote:FireServer(v, root.Position)
                            elseif type(remote) == "table" then
                                remote.Attack:FireServer(v)
                            end
                            -- Instant Kill Backup
                            v.Health = 0
                        end)
                    end
                end
            end
        end
    end
end)

-- FLY & SPEED
local bv
RunService.Heartbeat:Connect(function()
    local c = LocalPlayer.Character
    if Config.Fly and c and c:FindFirstChild("HumanoidRootPart") then
        if not bv then
            bv = Instance.new("BodyVelocity", c.HumanoidRootPart)
            bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        end
        bv.Velocity = workspace.CurrentCamera.CFrame.LookVector * 100
    else
        if bv then bv:Destroy() bv = nil end
    end
    
    if Config.Speed and c and c:FindFirstChild("Humanoid") then
        c.Humanoid.WalkSpeed = 100
    elseif not Config.Speed and c and c:FindFirstChild("Humanoid") then
        c.Humanoid.WalkSpeed = 16
    end
end)

-- Buttons
local function Add(txt, key)
    local b = Instance.new("TextButton", Menu)
    b.Size = UDim2.new(1, -20, 0, 35)
    b.Position = UDim2.new(0, 10, 0, (#Menu:GetChildren()-3) * 40 + 10)
    b.Text = txt .. ": OFF"
    b.TextColor3 = Color3.new(1,0,0)
    b.BackgroundColor3 = Color3.fromRGB(30,30,30)
    b.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        b.Text = txt .. (Config[key] and ": ON" or ": OFF")
        b.TextColor3 = Config[key] and Color3.new(0,1,0) or Color3.new(1,0,0)
    end)
end

Add("Auto Kill", "Kill")
Add("Fly", "Fly")
Add("Speed", "Speed")
